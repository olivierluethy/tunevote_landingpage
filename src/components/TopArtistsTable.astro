---
// Server-side initial data
export interface Props { initialData: any[] }
const { initialData } = Astro.props;
---

<div id="top-artists-table" class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md">
  <div class="px-6 py-4 bg-white/5 flex justify-between items-center">
    <h3 class="font-semibold text-lg">Live Today’s Artist</h3>
    <span class="text-xs text-green-400 animate-pulse">● LIVE</span>
  </div>

  <table class="min-w-full">
    <tbody>
      {initialData.length === 0 && <tr><td colspan="3" class="py-20 text-center text-gray-500">No votes yet – be the first!</td></tr>}
      {initialData.map((artist, i) => (
        <tr class="border-t border-white/5 hover:bg-white/10 transition-colors">
          <td class="px-6 py-4 text-center font-bold">{i < 3 ? ['1st','2nd','3rd'][i] : i+1}</td>
          <td class="px-6 py-4">
            <div class="flex items-center gap-4">
              <img src={artist.image_url || '/placeholder-artist.png'} alt={artist.artist_name} class="w-12 h-12 rounded-full object-cover border border-white/10" />
              <span class="font-semibold">{artist.artist_name}</span>
            </div>
          </td>
          <td class="px-6 py-4 text-right font-mono font-bold text-purple-300">
            {artist.vote_count.toLocaleString()}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script is:inline>
  const socket = io("http://localhost:4000");
  socket.on("today_top_artists_updated", (data) => {
    const tbody = document.querySelector("#top-artists-table tbody");
    tbody.innerHTML = data.map((a, i) => `
      <tr class="border-t border-white/5 hover:bg-white/10 transition-colors animate-fadeIn">
        <td class="px-6 py-4 text-center font-bold">${i < 3 ? ['1st','2nd','3rd'][i] : i+1}</td>
        <td class="px-6 py-4"><div class="flex items-center gap-4">
          <img src="${a.image_url || '/placeholder-artist.png'}" class="w-12 h-12 rounded-full object-cover border border-white/10" />
          <span class="font-semibold">${a.artist_name}</span>
        </div></td>
        <td class="px-6 py-4 text-right font-mono font-bold text-purple-300 scale-animation">${a.vote_count.toLocaleString()}</td>
      </tr>
    `).join('');
  });
</script>

<style>
  .animate-fadeIn { animation: fadeIn 0.6s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .scale-animation { animation: scalePulse 0.4s ease; }
  @keyframes scalePulse { 0% { transform: scale(1); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }
</style>