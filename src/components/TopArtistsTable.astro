---
import { h } from 'preact';
import { render } from 'preact';
import { useState, useEffect } from 'preact/hooks';

export interface Props {
  initialData?: Array<{
    artist_name: string;
    image_url?: string;
    vote_count: number;
  }>;
}

const { initialData = [] } = Astro.props;
---

<div id="top-artists-container" class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md">
  <div class="px-6 py-4 bg-white/5 flex justify-between items-center">
    <h3 class="font-semibold text-lg">Live Today’s Artist</h3>
    <span class="text-xs text-green-400 animate-pulse">● LIVE</span>
  </div>

  <div id="top-artists-table"></div>
</div>

<script type="module" client:load>
import { h } from 'preact';
import { render } from 'preact';
import { useState, useEffect } from 'preact/hooks';

function TopArtistsTable({ initialData }) {
  const [artists, setArtists] = useState(initialData);

  useEffect(() => {
    fetch('http://localhost:4000/top-today')
      .then(res => res.json())
      .then(setArtists)
      .catch(console.warn);

    const socket = io('http://localhost:4000');
    socket.on('today_top_artists_updated', setArtists);

    return () => socket.disconnect();
  }, []);

  if (!artists || artists.length === 0) {
    return <div class="py-20 text-center text-gray-500">No votes yet – be the first!</div>;
  }

  return (
    <table class="min-w-full">
      <tbody>
        {artists.map((artist, i) => (
          <tr key={artist.artist_name} class="border-t border-white/5 hover:bg-white/10 transition-colors">
            <td class="px-6 py-4 text-center font-bold">{i < 3 ? ['1st','2nd','3rd'][i] : i+1}</td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-4">
                <img
                  src={artist.image_url || '/placeholder-artist.png'}
                  alt={artist.artist_name}
                  class="w-12 h-12 rounded-full object-cover border border-white/10"
                  loading="lazy"
                />
                <span class="font-semibold">{artist.artist_name}</span>
              </div>
            </td>
            <td class="px-6 py-4 text-right font-mono font-bold text-purple-300">
              {artist.vote_count.toLocaleString()}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  );
}

render(<TopArtistsTable initialData={window.__INITIAL_ARTISTS__ || []} />, document.getElementById('top-artists-table'));
</script>

<style>
.animate-fadeIn { animation: fadeIn 0.6s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
.scale-animation { animation: scalePulse 0.4s ease; }
@keyframes scalePulse { 0% { transform: scale(1); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }
</style>
