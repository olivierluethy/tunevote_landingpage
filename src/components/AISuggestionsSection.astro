---
// src/components/AISuggestionsSection.astro
---

<section class="py-20 px-4">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16 opacity-0 translate-y-8 animate-fade-in-up">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">AI-Powered Suggestions</h2>
      <p class="text-xl text-gray-400">Never run out of great music</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {[
        { mood: "Chill", emoji: "🌊", songs: ["Ocean Eyes", "Yellow", "Weightless"] },
        { mood: "Party", emoji: "🎉", songs: ["Uptown Funk", "Dance Monkey", "Levitating"] },
        { mood: "Focus", emoji: "🎯", songs: ["Clair de Lune", "Weightless", "Nuvole Bianche"] },
      ].map((card, i) => (
        <div
          class="bg-gradient-to-br from-purple-600/20 to-pink-600/20 backdrop-blur rounded-2xl p-6 border border-white/10 opacity-0 translate-y-8 animate-fade-in-up"
          style={`animation-delay: ${i * 150 + 300}ms;`}
        >
          <div class="text-5xl mb-4 text-center">{card.emoji}</div>
          <h3 class="text-xl font-bold mb-3 text-center">{card.mood} Mode</h3>
          <ul class="space-y-2">
            {card.songs.map(song => (
              <li class="text-sm text-gray-300 flex items-center justify-between">
                <span>{song}</span>
                <button class="text-purple-400 hover:text-purple-300">+</button>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(2rem); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>