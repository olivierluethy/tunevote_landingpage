---
import { h } from 'preact';
import { render } from 'preact';
import { useState, useEffect } from 'preact/hooks';

export interface Props {
  initialData?: Array<{
    youtube_id: string;
    song_title: string;
    artist_name: string;
    thumbnail?: string;
    queue_count: number;
  }>;
}

const { initialData = [] } = Astro.props;
---

<div id="top-weekly-songs-container" class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md">
  <div class="px-6 py-4 bg-white/5 flex justify-between items-center">
    <h3 class="font-semibold text-lg">Top Songs dieser Woche 🔥</h3>
    <span class="text-xs text-green-400 animate-pulse">● LIVE</span>
  </div>

  <div id="top-weekly-songs-table"></div>
</div>

<script type="module" client:load>
import { h } from 'preact';
import { render } from 'preact';
import { useState, useEffect } from 'preact/hooks';

function TopWeeklySongsTable({ initialData }) {
  const [songs, setSongs] = useState(initialData);

  useEffect(() => {
    fetch('http://localhost:4000/top-weekly-songs')
      .then(res => res.json())
      .then(setSongs)
      .catch(console.warn);

    const socket = io('http://localhost:4000');
    socket.on('weekly_songs_updated', setSongs);

    return () => socket.disconnect();
  }, []);

  if (!songs || songs.length === 0) {
    return <div class="py-20 text-center text-gray-500">Noch keine Songs diese Woche – lasst die Musik laufen! 🎵</div>;
  }

  return (
    <table class="min-w-full border-collapse">
      <thead>
        <tr class="border-b border-white/10 text-left text-sm text-gray-400">
          <th class="px-6 py-3 text-center">#</th>
          <th class="px-6 py-3">Song</th>
          <th class="px-6 py-3">Artist</th>
          <th class="px-6 py-3 text-right">Abspielungen</th>
        </tr>
      </thead>
      <tbody>
        {songs.map((song, i) => (
          <tr key={song.youtube_id} class="border-t border-white/5 hover:bg-white/10 transition-colors group">
            <td class="px-6 py-4">
              <div class="flex items-center justify-center w-8 h-8 rounded-full bg-white/5 font-bold text-sm">{i + 1}</div>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-4">
                <div class="relative overflow-hidden w-12 h-12 rounded-lg border border-white/10">
                  <img src={song.thumbnail || '/placeholder-song.png'} alt={song.song_title} class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div>
                  <p class="font-semibold text-gray-100 group-hover:text-purple-400 transition-colors">{song.song_title}</p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 text-gray-300">{song.artist_name}</td>
            <td class="px-6 py-4 text-right">
              <span class="font-mono font-bold text-purple-300 inline-block scale-animation">{song.queue_count.toLocaleString()}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  );
}

render(<TopWeeklySongsTable initialData={window.__INITIAL_SONGS__ || []} />, document.getElementById('top-weekly-songs-table'));
</script>

<style>
.scale-animation { animation: scalePulse 0.4s ease-out; }
@keyframes scalePulse { 0% { transform: scale(1); } 50% { transform: scale(1.3); } 100% { transform: scale(1); } }

.animate-fadeIn { animation: fadeIn 0.6s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
