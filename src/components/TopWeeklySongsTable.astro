---
// src/components/TopWeeklySongsTable.astro
export interface Props {
  initialData: Array<{
    youtube_id: string;
    song_title: string;
    artist_name: string;
    thumbnail?: string;
    queue_count: number;
  }>;
}

const { initialData } = Astro.props;
---

<div class="overflow-hidden rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md">
  <div class="px-6 py-4 bg-white/5 flex justify-between items-center">
    <h3 class="font-semibold text-lg">Top Songs dieser Woche 🔥</h3>
    <span class="text-xs text-green-400 animate-pulse">● LIVE</span>
  </div>

  {initialData.length === 0 ? (
    <div class="py-20 text-center text-gray-500">
      Noch keine Songs diese Woche – lasst die Musik laufen! 🎵
    </div>
  ) : (
    <table class="min-w-full border-collapse">
      <thead>
        <tr class="border-b border-white/10 text-left text-sm text-gray-400">
          <th class="px-6 py-3 text-center">#</th>
          <th class="px-6 py-3">Song</th>
          <th class="px-6 py-3">Artist</th>
          <th class="px-6 py-3 text-right">Abspielungen</th>
        </tr>
      </thead>
      <tbody>
        {initialData.map((song, index) => (
          <tr class="border-t border-white/5 hover:bg-white/10 transition-colors group">
            <td class="px-6 py-4">
              <div class="flex items-center justify-center w-8 h-8 rounded-full bg-white/5 font-bold text-sm">
                {index + 1}
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-4">
                <div class="relative overflow-hidden w-12 h-12 rounded-lg border border-white/10">
                  <img
                    src={song.thumbnail || "/placeholder-song.png"}
                    alt={song.song_title}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div>
                  <p class="font-semibold text-gray-100 group-hover:text-purple-400 transition-colors">
                    {song.song_title}
                  </p>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 text-gray-300">
              {song.artist_name}
            </td>
            <td class="px-6 py-4 text-right">
              <span class="font-mono font-bold text-purple-300 inline-block scale-animation">
                {song.queue_count.toLocaleString()}
              </span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
</div>

<style>
  .scale-animation {
    animation: scalePulse 0.4s ease-out;
  }
  @keyframes scalePulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.3); }
    100% { transform: scale(1); }
  }
</style>