---
// src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro'; // falls du eine hast, sonst weglassen
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---

<BaseLayout title="TuneVote Blog">
  <section class="max-w-7xl mx-auto px-4 py-20">
    <h1 class="text-5xl md:text-6xl font-bold text-center mb-6 bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
      TuneVote Blog
    </h1>
    <p class="text-xl text-gray-400 text-center mb-16 max-w-3xl mx-auto">
      News, Tipps für DJs, Community-Stories und alles rund um kollaboratives Musik-Erlebnis.
    </p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map(post => (
        <a href={`/blog/${post.slug}`} class="group block">
          <article class="bg-white/5 backdrop-blur rounded-2xl p-6 border border-white/10 hover:border-purple-500/50 transition-all">
            <time datetime={post.data.pubDate} class="text-sm text-gray-500">
              {new Date(post.data.pubDate).toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h2 class="text-2xl font-bold mt-4 mb-3 group-hover:text-purple-400 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-gray-400 line-clamp-3">
              {post.data.description}
            </p>
            <span class="inline-block mt-6 text-purple-400 font-semibold group-hover:text-purple-300">
              Weiterlesen →
            </span>
          </article>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>