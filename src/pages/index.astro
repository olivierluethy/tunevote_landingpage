---
// src/pages/index.astro
import '../styles/global.css';
import { Music, Play, Users, Zap, Heart, Shuffle, Headphones, Mic, Sparkles } from 'lucide-astro';

import TopArtistsTable from '../components/TopArtistsTable.astro';
import TopWeeklySongsTable from '../components/TopWeeklySongsTable.astro';
import LiveVotingDemo from '../components/LiveVotingDemo.astro';
import ArtistDashboardSection from '../components/ArtistDashboardSection.astro';
import HowItWorksSection from '../components/HowItWorksSection.astro';
import AISuggestionsSection from '../components/AISuggestionsSection.astro';

// Server-side fetch for initial data (SEO-friendly + fast first paint)
const [topArtistsRes, topWeeklyRes] = await Promise.all([
  fetch('http://localhost:4000/top-today').then(r => r.json()).catch(() => []),
  fetch('http://localhost:4000/top-weekly-songs').then(r => r.json()).catch(() => [])
]);

// Mock live votes for demo (same as original)
const initialVotes = { yes: 42, no: 8, idk: 15 };

// Queue preview data
const queue = [
  { id: 1, title: "Blinding Lights", artist: "The Weeknd", votes: 89, cover: "https://upload.wikimedia.org/wikipedia/commons/a/a0/The_Weeknd_Portrait_by_Brian_Ziff.jpg" },
  { id: 2, title: "Levitating", artist: "Dua Lipa", votes: 76, cover: "https://upload.wikimedia.org/wikipedia/commons/7/72/DuaLipa-byPhilipRomano.jpg" },
  { id: 3, title: "Good 4 U", artist: "Olivia Rodrigo", votes: 71, cover: "https://upload.wikimedia.org/wikipedia/commons/b/b7/Glasto2025-546_%28cropped%29_%282%29.jpg" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TuneVote — Collaborative Music Sessions</title>
    <meta name="description" content="Vote on music together in real-time. Perfect for parties, road trips, and workouts." />

    <!-- Open Graph -->
    <meta property="og:title" content="TuneVote — Vote. Play. Enjoy." />
    <meta property="og:description" content="Collaborative music sessions where the crowd decides what plays next." />
    <meta property="og:image" content="/og-image.jpg" />
    <meta property="og:url" content="https://tunevote.app" />
    <meta property="og:type" content="website" />

    <!-- Favicons, etc. can be added later -->
  </head>

  <body class="bg-black text-white min-h-screen">
    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 backdrop-blur-lg bg-black/20 border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16">
          <a href="/" class="flex items-center space-x-2">
            <Music class="w-8 h-8 text-purple-400" />
            <span class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
              TuneVote
            </span>
          </a>
          <div class="flex space-x-4">
            <a href="/dashboard" class="px-4 py-2 rounded-lg bg-gradient-to-r from-purple-600 to-pink-600 font-semibold hover:shadow-lg hover:shadow-purple-500/40 transition-all">
              Start Session
            </a>
            <form action="http://localhost:4000/join" method="POST" class="inline">
              <button type="submit" class="px-4 py-2 rounded-lg border border-purple-400 text-purple-300 hover:bg-purple-400/20 font-semibold transition-all">
                Join Session
              </button>
            </form>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="pt-32 pb-20 px-4 relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-r from-purple-600/20 to-pink-600/20 blur-3xl"></div>
      <div class="max-w-7xl mx-auto relative z-10 text-center">
        <h1 class="text-6xl md:text-8xl font-bold mb-6 bg-gradient-to-r from-purple-400 via-pink-400 to-cyan-400 bg-clip-text text-transparent">
          TuneVote
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-gray-300 max-w-3xl mx-auto">
          Collaborative Music Sessions – Vote, Play, Enjoy.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
          <a href="/dashboard" class="group px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full font-semibold text-lg flex items-center justify-center space-x-2 hover:shadow-2xl hover:shadow-purple-500/50 transition-all">
            <Play class="w-5 h-5 group-hover:scale-110 transition-transform" />
            <span>Start a Session</span>
          </a>
          <form action="http://localhost:4000/join" method="POST" class="inline">
            <button type="submit" class="group px-8 py-4 bg-white/10 backdrop-blur rounded-full font-semibold text-lg flex items-center justify-center space-x-2 border border-white/20 hover:bg-white/20 transition-all">
              <Users class="w-5 h-5" />
              <span>Join a Session</span>
            </button>
          </form>
        </div>

        <div class="relative max-w-4xl mx-auto mt-16">
          <div class="bg-black/40 backdrop-blur rounded-2xl p-8 border border-white/10">
            <div class="bg-gray-800 rounded-xl h-96 flex items-center justify-center">
              <div class="text-center">
                <Play class="w-16 h-16 mx-auto mb-4 text-purple-400" />
                <p class="text-lg">Interactive Demo Coming Soon</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Animated Visualizer Bars -->
      <div class="absolute bottom-0 left-0 right-0 h-32 overflow-hidden opacity-50">
        <div class="flex space-x-2 h-full items-end justify-center">
          {[...Array(20)].map((_, i) => (
            <div
              class="w-2 bg-gradient-to-t from-purple-400 to-pink-400 rounded-full"
              style={`animation: wave 2s infinite ease-in-out ${i * 0.1}s; height: ${20 + Math.sin(i) * 60}px;`}
            ></div>
          ))}
        </div>
      </div>
    </section>

    <!-- Community Poll -->
    <section class="py-20 px-4 bg-gradient-to-b from-black/50 to-black">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Community Poll</h2>
        <p class="text-xl text-gray-400">What does the TuneVote community think?</p>

        <div class="bg-white/5 backdrop-blur-lg rounded-3xl p-8 border border-white/10 shadow-2xl mt-12">
          <h3 class="text-2xl font-semibold mb-8">Which artist should dominate 2025?</h3>
          <div class="space-y-6">
            {[
              { name: "The Weeknd", votes: 3124, color: "from-purple-500 to-purple-700" },
              { name: "Taylor Swift", votes: 2987, color: "from-pink-500 to-rose-600" },
              { name: "Drake", votes: 2105, color: "from-cyan-500 to-blue-600" },
              { name: "Billie Eilish", votes: 1893, color: "from-green-500 to-emerald-600" },
            ].map(option => {
              const percentage = (option.votes / 10109) * 100;
              return (
                <div class="text-left">
                  <div class="flex justify-between mb-2">
                    <span class="font-medium">{option.name}</span>
                    <span class="text-purple-300">{option.votes.toLocaleString()} votes</span>
                  </div>
                  <div class="h-10 bg-gray-800 rounded-full overflow-hidden">
                    <div class={`h-full bg-gradient-to-r ${option.color}`} style={`width: ${percentage}%`}></div>
                  </div>
                </div>
              );
            })}
          </div>
          <div class="mt-8 flex justify-center gap-4">
            <button class="px-8 py-3 bg-gradient-to-r from-purple-600 to-pink-600 rounded-full font-semibold hover:shadow-xl hover:shadow-purple-500/30 transition-all">
              Vote Now
            </button>
            <button class="px-8 py-3 bg-white/10 backdrop-blur rounded-full font-semibold border border-white/20 hover:bg-white/20 transition-all">
              See Results
            </button>
          </div>
          <p class="text-center text-sm text-gray-500 mt-6">10,109 votes • Updated live</p>
        </div>
      </div>
    </section>

    <!-- Top Artists & Weekly Songs -->
    <section class="py-20 px-4 bg-gradient-to-b from-black to-black/30">
      <div class="max-w-7xl mx-auto text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Top Artists Today</h2>
        <p class="text-xl text-gray-400">Voted by the community – updated live</p>
      </div>
      <TopArtistsTable initialData={topArtistsRes} />
    </section>

    <section class="py-20 px-4 bg-gradient-to-b from-black/30 to-black">
      <div class="max-w-7xl mx-auto text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold mb-4">Top Songs dieser Woche</h2>
        <p class="text-xl text-gray-400">Die meistabgespielten Tracks der aktuellen Woche</p>
      </div>
      <TopWeeklySongsTable initialData={topWeeklyRes} />
    </section>

	<HowItWorksSection />

	<LiveVotingDemo client:load initialVotes={initialVotes} />

	<ArtistDashboardSection queue={queue} />

	<AISuggestionsSection />

    <!-- How It Works, Live Demo, etc. -->
    <!-- (All other sections remain visually identical using pure HTML/Tailwind) -->
    <!-- Omitted here for brevity, but included in full version below -->

    

    <!-- Remaining sections: How It Works, Artist Dashboard, AI Suggestions, Footer -->
    <!-- Full code available on request – all static, no JS needed -->

    <!-- Footer -->
    <footer class="bg-black/50 backdrop-blur border-t border-white/10 py-12 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <div class="flex flex-col md:flex-row justify-between items-center mb-8">
          <div class="flex items-center space-x-2 mb-4 md:mb-0">
            <Music class="w-8 h-8 text-purple-400" />
            <span class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">TuneVote</span>
          </div>
          <div class="flex space-x-6">
            {["Twitter", "Instagram", "Discord", "GitHub"].map(s => (
              <a href="#" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors">
                {s[0]}
              </a>
            ))}
          </div>
        </div>
        <p class="text-sm text-gray-400">© 2026 TuneVote. All rights reserved.</p>
      </div>
    </footer>

    <style>
      @keyframes wave {
        0%, 100% { height: 20px; }
        50% { height: 80px; }
      }
    </style>
  </body>
</html>